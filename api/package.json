{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "prisma": {
    "seed": "ts-node prisma/seeds/index.ts"
  },
  "scripts": {
    "start:dev": "concurrently -n BFF,AUTH,USER,STOCK,ORDER,AUDIT -c blue,green,yellow,cyan,magenta,white \"yarn start:dev:bff\" \"yarn start:dev:auth\" \"yarn start:dev:user\" \"yarn start:dev:stock\" \"yarn start:dev:order\" \"yarn start:dev:audit\"",
    "start:dev:bff": "nest start bff --watch",
    "start:dev:auth": "nest start auth-api --watch",
    "start:dev:user": "nest start user-api --watch",
    "start:dev:stock": "nest start stock-api --watch",
    "start:dev:order": "nest start order-api --watch",
    "start:dev:audit": "nest start audit-consumer --watch",
    "build": "nest build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seeds/index.ts",
    "seed:core": "SEED_MODE=core ts-node prisma/seeds/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "mongoose": "^9.6.2",
    "neverthrow": "^8.2.0",
    "opossum": "^9.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@testcontainers/mongodb": "^12.0.1",
    "@testcontainers/postgresql": "^12.0.1",
    "@testcontainers/rabbitmq": "^12.0.1",
    "@testcontainers/redis": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^libs/core-cqrs(|/.*)$": "<rootDir>/libs/core-cqrs/src/$1",
      "^libs/core-domain(|/.*)$": "<rootDir>/libs/core-domain/src/$1",
      "^libs/core-events(|/.*)$": "<rootDir>/libs/core-events/src/$1",
      "^libs/core-resilience(|/.*)$": "<rootDir>/libs/core-resilience/src/$1",
      "^libs/core-saga(|/.*)$": "<rootDir>/libs/core-saga/src/$1",
      "^libs/core-shared(|/.*)$": "<rootDir>/libs/core-shared/src/$1"
    }
  }
}