    },
    "audit-consumer": {
      "type": "application",
      "root": "apps/audit-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/audit-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/audit-consumer/tsconfig.app.json"
      }
    },
    "core-domain": {
      "type": "library",
      "root": "libs/core-domain",
      "entryFile": "index",
      "sourceRoot": "libs/core-domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core-domain/tsconfig.lib.json"
      }
    },
    "core-cqrs": {
      "type": "library",
      "root": "libs/core-cqrs",
