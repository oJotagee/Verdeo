{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/bff/src",
  "monorepo": true,
  "root": "apps/bff",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/bff/tsconfig.app.json",
    "deleteOutDir": true,
    "plugins": [],
    "assets": []
  },
  "projects": {
    "bff": {
      "type": "application",
      "root": "apps/bff",
      "entryFile": "main",
      "sourceRoot": "apps/bff/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bff/tsconfig.app.json"
      }
    },
    "auth-api": {
      "type": "application",
      "root": "apps/auth-api",
      "entryFile": "main",
      "sourceRoot": "apps/auth-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-api/tsconfig.app.json"
      }
    },
    "user-api": {
      "type": "application",
      "root": "apps/user-api",
      "entryFile": "main",
      "sourceRoot": "apps/user-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-api/tsconfig.app.json"
      }
    },
    "stock-api": {
      "type": "application",
      "root": "apps/stock-api",
      "entryFile": "main",
      "sourceRoot": "apps/stock-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stock-api/tsconfig.app.json"
      }
    },
    "order-api": {
      "type": "application",
      "root": "apps/order-api",
      "entryFile": "main",
      "sourceRoot": "apps/order-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order-api/tsconfig.app.json"
