        "tsConfigPath": "libs/core-events/tsconfig.lib.json"
      }
    },
    "core-resilience": {
      "type": "library",
      "root": "libs/core-resilience",
      "entryFile": "index",
      "sourceRoot": "libs/core-resilience/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core-resilience/tsconfig.lib.json"
